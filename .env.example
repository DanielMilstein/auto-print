DATABASE_URL=postgres://autoprint:autoprint@localhost:5434/autoprint
# Directory for uploaded g-code cache, failure images and timelapses
DATA_DIR=./data
# Initial login password (only used to seed the very first password; change it in Settings)
INITIAL_PASSWORD=autoprint

# --- Production behind nginx (see deploy/ and README "Deployment (Jetson)") ---
# Only nginx talks to node; keep it off the network. Use 0.0.0.0 only if vision
# services on other machines must POST webhooks straight to :3000.
HOST=127.0.0.1
PORT=3000
# Trust nginx's forwarded headers so SvelteKit derives the public origin
# (https://<jetson>.<tailnet>.ts.net) and its CSRF origin check passes.
# Without these adapter-node assumes https and form POSTs fail with
# "Cross-site POST form submissions are forbidden".
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
# g-code uploads are multi-MB; adapter-node's default is 512K. nginx enforces its own limit.
BODY_SIZE_LIMIT=Infinity
